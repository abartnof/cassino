#!/usr/bin/env bash
# The gate before every commit: formatting, lints, tests. It prints a short
# summary and exits non-zero on any failure. Never pipe it (`| tail` would
# hide its status): run it bare, as `bin/gate && git commit ...`.
set -euo pipefail
cd "$(dirname "$0")/.."
[ -f "$HOME/.cargo/env" ] && source "$HOME/.cargo/env"
if ! cargo fmt --all -- --check >/dev/null 2>&1; then
  echo "gate: FAILED: cargo fmt (run cargo fmt)" >&2
  exit 1
fi
if ! out=$(cargo clippy --all-targets --quiet -- -D warnings 2>&1); then
  echo "$out" | head -40 >&2
  echo "gate: FAILED: clippy" >&2
  exit 1
fi
if ! out=$(cargo test --quiet 2>&1); then
  echo "$out" | grep -E "FAILED|panicked|error" | head -40 >&2
  echo "gate: FAILED: tests" >&2
  exit 1
fi
passed=$(echo "$out" | grep -oE "test result: ok\. [0-9]+ passed" | awk '{s += $4} END {print s}')
# The table's pure modules, in Node (web3d/test), once its libraries are in,
# against the engine as it is now: the module is built first, so no test that
# needs it skips or runs against an old one (the table review's Q2).
if [ -d web3d/node_modules ]; then
  if ! out=$(cargo build --quiet --release -p cassino-wasm --lib --target wasm32-unknown-unknown 2>&1); then
    echo "$out" | head -20 >&2
    echo "gate: FAILED: building the wasm module" >&2
    exit 1
  fi
  if ! node_out=$(cd web3d && node --test test/ 2>&1); then
    echo "$node_out" | grep -E "not ok|Error|expected|actual" | head -40 >&2
    echo "gate: FAILED: web3d node tests" >&2
    exit 1
  fi
  node_passed=$(echo "$node_out" | grep -oE "^# pass [0-9]+" | awk '{print $3}')
  # The committed page is the game itself: it must be built from these
  # sources (the build is deterministic).
  if ! out=$(python3 web3d/build.py --check 2>&1); then
    echo "$out" | tail -3 >&2
    echo "gate: FAILED: the built page is stale" >&2
    exit 1
  fi
  passed="$passed + $node_passed in Node"
fi
echo "gate: ok ($passed tests passed)"
